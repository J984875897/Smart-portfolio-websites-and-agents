+            except ERRORS:
+                st.error('更新未完成；先前已打开缓存保留。请检查本地目录或稍后手动重试。')
+    st.subheader('本地缓存')
+    try:
+        runs=list_runs(root)
+    except ERRORS:
+        runs=[]
