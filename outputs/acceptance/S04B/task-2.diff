+"""Explicit reference updates and fully verified offline evidence inspection."""
+from datetime import date
+from io import BytesIO
+import json
+import os
+from pathlib import Path
+import pandas as pd
+import streamlit as st
+from portfolio.data.reference_updates import REFERENCE_CATALOG, run_reference_update, validate_reference_plan
+from portfolio.data.snapshots import list_runs, load_snapshot, read_artifact, update_log
+
+ROOT = Path(__file__).resolve().parents[2]
+ERRORS = (ValueError, OSError, KeyError, TypeError)
+STATUS = {'success':'成功（请求月份完整）','partial':'部分可用（仅诊断）','unavailable':'不可用','cancelled':'已取消'}
+REASONS = {'tls_error':'TLS 安全连接失败','transport_error':'连接失败','timeout':'请求超时','rate_limited':'来源限流','http_error':'来源 HTTP 错误','parse_error':'来源解析失败','page_limit':'达到分页上限','empty_data':'无数据','complete_requested_months':'请求月份完整且数值有效','missing_or_invalid_values_or_months':'月份缺失或数值无效','cancelled':'已取消','not_requested':'未请求'}
+
+
+def reference_root():
+    return Path(os.environ.get('PORTFOLIO_REFERENCE_DOWNLOADS_ROOT',str(ROOT/'data/reference_downloads'))).resolve()
+
+
+def _metadata(dataset):
+    m=REFERENCE_CATALOG[dataset]
+    return {'数据集':dataset,'名称':('美国' if m['region']=='US' else '亚太（日本除外）')+' '+m['model']+' 因子' if m['kind']=='factor' else '香港金管局官方美元兑港币','来源':m['provider'],'地区':{'US':'美国','Asia Pacific ex Japan':'亚太（日本除外）','Hong Kong':'香港'}[m['region']],'模型':m['model'] or '官方汇率','币种':m['currency'],'频率':'月度' if m['frequency']=='monthly' else '日度实际观察','单位':'小数' if m['unit']=='decimal' else '每 1 USD 对应 HKD'}
+
+
+def _bound(root,run_id,manifest):
+    return dict(root=str(root),run_id=run_id,manifest=manifest)
+
+
+def _verified(binding,root):
+    if binding['root']!=str(root):
+        raise ValueError('different root')
+    manifest=load_snapshot(root,binding['run_id'])
+    if manifest.get('schema_version')!=2 or manifest!=binding['manifest']:
+        raise ValueError('changed snapshot')
+    return manifest
+
+
+def _items(manifest):
+    st.caption(f"版本编号：{manifest['run_id']} · UTC：{manifest['created_utc']} · 原请求 {manifest['start']}（含）至 {manifest['end_exclusive']}（不含）")
+    st.dataframe(pd.DataFrame([{'数据集':i['dataset'],'状态':STATUS[i['status']],'原因':REASONS.get(i['reason'],'来源检查未通过'),'行数':i['rows'],'实际首日':i['first_date'],'实际末日':i['last_date']} for i in manifest['items']]),hide_index=True,width='stretch')
+
+
+def _evidence(root,manifest,prefix,usable=False):
+    """Call only after the entire bound snapshot passed verification."""
+    rid=manifest['run_id']
+    st.download_button('导出快照清单', (json.dumps(manifest,ensure_ascii=False,indent=2)+'\n').encode(),'snapshot_manifest.json',key=prefix+'_manifest')
+    if usable:
+        datasets=[i['dataset'] for i in manifest['items'] if i['status']=='success']
+        dataset=st.selectbox('成功缓存数据集',datasets,key='ref_dataset')
+        item=next(i for i in manifest['items'] if i['dataset']==dataset)
+        st.dataframe(pd.DataFrame([_metadata(dataset)]),hide_index=True,width='stretch')
+        st.caption(f"实际范围：{item['first_date']} 至 {item['last_date']} · {item['rows']} 行")
+        payload=read_artifact(root,rid,item['table_file'])
+        st.dataframe(pd.read_csv(BytesIO(payload)),hide_index=True,width='stretch')
+        st.download_button('导出已验证数据 CSV',payload,item['table_file'],key='ref_table')
+    raw=[name for i in manifest['items'] for name in [*i['raw_files'],i['source_file']] if name]
+    if raw:
+        name=st.selectbox('原始响应 / French 原始 CSV',raw,key=prefix+'_raw_file')
+        st.download_button('导出原始证据',read_artifact(root,rid,name),name,key=prefix+'_raw')
+    partial=[i for i in manifest['items'] if i['status']=='partial' and i['table_file']]
+    if partial:
+        with st.expander('部分可用数据 · 仅诊断'):
+            st.warning('缺失值保留，仅供诊断，不可作为正式输入或送入产品导入。')
+            for item in partial:
+                payload=read_artifact(root,rid,item['table_file'])
+                st.caption(item['dataset'])
+                st.dataframe(pd.read_csv(BytesIO(payload)),hide_index=True,width='stretch')
+                st.download_button('导出诊断 CSV · '+item['dataset'],payload,item['table_file'],key=prefix+'_diag_table_'+item['dataset'])
+
+
+def render():
+    s=st.session_state
+    root=reference_root()
+    for key in ('ref_plan','ref_active','ref_result'):
+        s.setdefault(key,None)
+    st.title('因子与官方汇率')
+    st.info('French 每项下载完整 ZIP 后筛选请求月份；四套模型的 SMB 各自独立。亚太（日本除外）不是香港专属因子；USD RF 不是港币无风险利率。')
+    st.caption('因子单位为小数；HKMA 汇率为 HKD per USD（每 1 USD 对应 HKD）。HKMA 仅检查请求月份存在实际日度观察，不认证逐日交易日历完整性，不自动聚合月度。无自动重试；缓存打开和导出均不联网。')
+    datasets=st.multiselect('数据集',list(REFERENCE_CATALOG),default=list(REFERENCE_CATALOG),key='ref_datasets')
+    cols=st.columns(4)
+    start=cols[0].date_input('起始月初（包含）',value=date(2025,1,1),key='ref_start_date')
+    end=cols[1].date_input('结束月初（不包含）',value=date(2026,1,1),key='ref_end')
+    timeout=cols[2].number_input('单请求超时（秒）',min_value=1,max_value=30,value=15,key='ref_timeout')
+    max_pages=cols[3].number_input('HKMA 最大页数',min_value=1,max_value=100,value=20,key='ref_max_pages')
+    st.caption('HKMA 每页固定 1000 条；短页或空页提前停止。')
+    fingerprint=(str(root),tuple(datasets),start.isoformat(),end.isoformat(),timeout,max_pages)
+    if s.get('ref_fingerprint')!=fingerprint:
+        s['ref_plan']=None
+        s['ref_fingerprint']=fingerprint
+    if st.button('生成下载计划',key='ref_prepare'):
+        try:
+            selected=validate_reference_plan(datasets,start.isoformat(),end.isoformat(),timeout,1000,max_pages)
+            s['ref_plan']=dict(datasets=selected,start=start.isoformat(),end=end.isoformat(),timeout=timeout,page_size=1000,max_pages=max_pages)
+        except ERRORS:
+            st.error('请选择不重复的允许数据集；日期必须为月初且起日早于止日，超时与页数须在允许范围内。')
+    plan=s['ref_plan']
+    if plan:
+        french=sum(d!='HKMA_USDHKD' for d in plan['datasets'])
+        hkma='HKMA_USDHKD' in plan['datasets']
+        st.subheader('计划预览')
+        st.write(f"请求数：最少 {french+int(hkma)}，最多 {french+(max_pages if hkma else 0)}；{plan['start']}（含）至 {plan['end']}（不含）")
+        st.dataframe(pd.DataFrame([_metadata(d) for d in plan['datasets']]),hide_index=True,width='stretch')
+        st.warning(f'仅支持开始前取消；同步下载过程中无法通过页面中断。超时为每个请求 {timeout} 秒；请求上限可能使总等待时间很长。')
+        if st.button('取消下载计划',key='ref_cancel'):
+            s['ref_plan']=None
+            st.rerun()
+        if st.button('开始下载',key='ref_start',type='primary'):
+            try:
+                with st.spinner('正在下载并保存来源证据…'):
+                    rid=run_reference_update(root,**plan)
+                    manifest=load_snapshot(root,rid)
+                    if manifest.get('schema_version')!=2: raise ValueError('wrong schema')
+                s['ref_result']=_bound(root,rid,manifest)
+                s['ref_plan']=None
+                st.success('本次尝试结束。请核对结果并显式打开所需缓存。')
+            except ERRORS:
+                st.error('更新未完成；先前已打开缓存保留。请检查本地目录或稍后手动重试。')
+    st.subheader('本地缓存')
+    try:
+        runs=list_runs(root)
+    except ERRORS:
+        runs=[]
+        st.error('缓存目录无法读取。')
+    if runs:
+        selected=st.selectbox('下载记录（最新在前）',runs,key='ref_run')
+        if st.button('校验并打开缓存',key='ref_open'):
+            try:
+                manifest=load_snapshot(root,selected)
+                if manifest.get('schema_version')!=2: raise ValueError('wrong schema')
+                binding=_bound(root,selected,manifest)
+                if any(i['status']=='success' for i in manifest['items']):
+                    s['ref_active']=binding
+                else:
+                    s['ref_result']=binding
+                    st.warning('此记录没有成功项；保留先前成功缓存，仅提供审计与诊断。')
+            except ERRORS:
+                st.error('缓存校验失败或不是参考数据 schema 2；先前缓存身份保留。')
+        try:
+            for rid in runs:
+                if load_snapshot(root,rid).get('schema_version')!=2: raise ValueError('wrong schema')
+            log=update_log(root)
+            st.download_button('导出更新日志 CSV',log.to_csv(index=False).encode(),'update_log.csv',key='ref_log')
+        except ERRORS:
+            st.warning('缓存完整性检查失败，停止完整日志导出。')
+    else:
+        st.caption('暂无下载记录。生成计划不会写入缓存。')
+    result=s['ref_result']
+    active=s['ref_active']
+    if result:
+        st.subheader('上次尝试结果（原请求范围）')
+        try:
+            manifest=_verified(result,root)
+            _items(manifest)
+            if not active or (active['root'],active['run_id'])!=(result['root'],result['run_id']):
+                with st.expander('本次尝试 · 审计与诊断导出'):
+                    _evidence(root,manifest,'ref_result')
+        except ERRORS:
+            st.error('尝试记录校验失败或缓存目录已改变，停止该记录所有导出。')
+    if active:
+        st.subheader('已打开缓存')
+        try:
+            manifest=_verified(active,root)
+            _items(manifest)
+            _evidence(root,manifest,'ref',usable=True)
+        except ERRORS:
+            st.error('已打开缓存校验失败或缓存目录已改变；保留原身份，停止所有缓存使用与导出。')
--- before/tests/test_reference_downloads_view.py
+++ after/tests/test_reference_downloads_view.py
@@ -0,0 +1,151 @@
+from datetime import date
+from pathlib import Path
+import io
+import zipfile
+import pytest
+from streamlit.testing.v1 import AppTest
+from portfolio.data.reference_updates import run_reference_update
+from portfolio.data.providers.base import RawResponse
+from portfolio.data.snapshots import load_snapshot, read_artifact
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+def start(monkeypatch, root):
+    monkeypatch.setenv('PORTFOLIO_REFERENCE_DOWNLOADS_ROOT', str(root))
+    at = AppTest.from_file(str(ROOT/'app/main.py'), default_timeout=15).run()
+    at.radio(key='workspace').set_value('因子与官方汇率').run()
+    assert not at.exception
+    return at
+
+
+def click(at, key):
+    at.button(key=key).click().run()
+    assert not at.exception
+
+
+def cache(root, partial=False, failed=False):
+    data = io.BytesIO()
+    with zipfile.ZipFile(data, 'w') as z:
+        z.writestr('F-F_Research_Data_Factors.csv', ',Mkt-RF,SMB,HML,RF\n202501,2,3,'+('-99.99' if partial else '4')+',0.4\n202502,1,2,3,0.3')
+    rid = run_reference_update(root, ['US_FF3'], '2025-01-01', '2025-03-01', fetch=lambda *a: RawResponse(b'limited',429) if failed else RawResponse(data.getvalue(),200))
+    return rid, load_snapshot(root,rid)
+
+
+def keys(at):
+    return {b.key for b in at.get('download_button')}
+
+
+def test_prepare_cancel_changes_and_navigation_are_offline(monkeypatch,tmp_path):
+    import app.views.reference_downloads as view
+    monkeypatch.setattr(view,'run_reference_update',lambda *a,**k:pytest.fail('unexpected network'))
+    at=start(monkeypatch,tmp_path)
+    assert at.date_input(key='ref_end').value == date(2026,1,1)
+    click(at,'ref_prepare')
+    assert len(at.session_state['ref_plan']['datasets'])==5
+    assert any('24' in x.value for x in at.markdown)
+    click(at,'ref_cancel')
+    assert at.session_state['ref_plan'] is None
+    click(at,'ref_prepare')
+    at.number_input(key='ref_max_pages').set_value(3).run()
+    assert at.session_state['ref_plan'] is None
+    at.date_input(key='ref_start_date').set_value(date(2025,1,2)).run()
+    click(at,'ref_prepare')
+    assert at.error
+    at.radio(key='workspace').set_value('数据导入').run()
+    assert not at.exception
+
+
+def test_explicit_start_and_open_preserve_active(monkeypatch,tmp_path):
+    import app.views.reference_downloads as view
+    rid,m=cache(tmp_path)
+    calls=[]
+    monkeypatch.setattr(view,'run_reference_update',lambda *a,**k:(calls.append(k) or rid))
+    at=start(monkeypatch,tmp_path)
+    click(at,'ref_open')
+    active=at.session_state['ref_active']
+    click(at,'ref_prepare'); click(at,'ref_start')
+    assert len(calls)==1
+    assert at.session_state['ref_active']==active
+    assert at.session_state['ref_result']['manifest']==m
+    failed,_=cache(tmp_path,failed=True)
+    at.run(); at.selectbox(key='ref_run').set_value(failed).run(); click(at,'ref_open')
+    assert at.session_state['ref_active']==active
+    assert at.session_state['ref_result']['run_id']==failed
+    assert {'ref_manifest','ref_table','ref_raw','ref_log','ref_result_manifest'} <= keys(at)
+    assert not any('导入' in b.label for b in at.button)
+
+
+def test_partial_diagnostics_and_corruption(monkeypatch,tmp_path):
+    rid,m=cache(tmp_path,partial=True)
+    at=start(monkeypatch,tmp_path); click(at,'ref_open')
+    assert at.session_state['ref_active'] is None
+    assert 'ref_result_diag_table_US_FF3' in keys(at)
+    assert any(df.value.isna().any().any() for df in at.dataframe)
+    assert read_artifact(tmp_path,rid,m['items'][0]['table_file'])
+    (tmp_path/'runs'/rid/m['items'][0]['table_file']).write_bytes(b'corrupt')
+    at.run()
+    assert not keys(at)
+    assert at.error
+
+
+def test_root_binding_and_manifest_change(monkeypatch,tmp_path):
+    rid,m=cache(tmp_path/'a')
+    at=start(monkeypatch,tmp_path/'a'); click(at,'ref_open'); click(at,'ref_prepare')
+    monkeypatch.setenv('PORTFOLIO_REFERENCE_DOWNLOADS_ROOT',str(tmp_path/'b'))
+    at.run()
+    assert at.session_state['ref_plan'] is None
+    assert 'ref_table' not in keys(at)
+    monkeypatch.setenv('PORTFOLIO_REFERENCE_DOWNLOADS_ROOT',str(tmp_path/'a'))
+    import json
+    p=tmp_path/'a'/'runs'/rid/'snapshot_manifest.json'
+    changed=dict(m,created_utc='2026-10-16T00:00:00+00:00')
+    p.write_text(json.dumps(changed))
+    at.run()
+    assert 'ref_manifest' not in keys(at)
+    assert at.error
+
+
+def test_exact_exports_mixed_scope_and_failed_start(monkeypatch,tmp_path):
+    import app.views.reference_downloads as view
+    from portfolio.data.providers.base import RawResponse
+    import json
+    good,gm=cache(tmp_path/'seed')
+    body=read_artifact(tmp_path/'seed',good,gm['items'][0]['raw_files'][0])
+    def fetch(dataset,*a,**k):
+        if dataset=='US_FF3': return RawResponse(body,200)
+        return RawResponse(json.dumps({'header':{'success':True},'result':{'records':[{'end_of_day':'2025-01-02','usd':7.8}]}}).encode(),200)
+    rid=run_reference_update(tmp_path,['US_FF3','HKMA_USDHKD'],'2025-01-01','2025-03-01',fetch=fetch)
+    m=load_snapshot(tmp_path,rid)
+    recorded={}
+    original=view.st.download_button
+    def capture(label,data,*args,**kwargs):
+        recorded[kwargs['key']]=data
+        return original(label,data,*args,**kwargs)
+    monkeypatch.setattr(view.st,'download_button',capture)
+    at=start(monkeypatch,tmp_path); click(at,'ref_open')
+    assert recorded['ref_table']==read_artifact(tmp_path,rid,m['items'][0]['table_file'])
+    assert recorded['ref_diag_table_HKMA_USDHKD']==read_artifact(tmp_path,rid,m['items'][1]['table_file'])
+    name=at.selectbox(key='ref_raw_file').value
+    assert recorded['ref_raw']==read_artifact(tmp_path,rid,name)
+    assert any('USD RF' in x.value and '港币' in x.value for x in at.info)
+    assert {'数据集','名称','来源','地区','模型','币种','频率','单位'} <= set(at.dataframe[1].value.columns)
+    active=at.session_state['ref_active']
+    def fail(*a,**k): raise OSError('SECRET exception')
+    monkeypatch.setattr(view,'run_reference_update',fail)
+    click(at,'ref_prepare'); click(at,'ref_start')
+    assert at.session_state['ref_active']==active
+    assert 'SECRET' not in str([x.value for x in at.error])
+    table=tmp_path/'runs'/rid/m['items'][0]['table_file']
+    table.write_bytes(b'corrupt')
+    at.run()
+    assert not keys(at)
+
+
+def test_schema_one_friendly_rejection(monkeypatch,tmp_path):
+    from portfolio.data.updates import run_update
+    run_update(tmp_path,['SPY'],'2025-01-01','2025-02-01',fetch=lambda *a:RawResponse(b'limited',429))
+    at=start(monkeypatch,tmp_path); click(at,'ref_open')
+    assert at.error
+    assert at.session_state['ref_active'] is None
+    assert not keys(at)
