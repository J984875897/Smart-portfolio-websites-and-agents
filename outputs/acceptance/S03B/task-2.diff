+    timing_mode = st.selectbox('时间证据输入', timing_choices, key='alignment_timing_mode')
+    payload, filename, sheet = b'', '', 0
+    error = None
+    if timing_mode == '上传时间证据':
+        timing = pd.DataFrame(columns=TIMING_FIELDS)
+        upload = st.file_uploader('选择时间证据 CSV 或 XLSX', type=['csv', 'xlsx'], key='alignment_upload')
+        try:
+            if upload is not None:
+                payload, filename = upload.getvalue(), upload.name
+                if filename.lower().endswith('.xlsx'):
