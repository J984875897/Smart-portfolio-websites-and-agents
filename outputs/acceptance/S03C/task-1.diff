+def sample_risk_free_quotes(case='完整报价'):
+    if case not in CASES:
+        raise ValueError('unknown synthetic case')
+    rows=[]
+    for date,quoted in zip(['2024-01-31','2024-02-29','2024-03-31'],['2023-12-29','2024-01-31','2024-02-29']):
